# Credentials for AWS account with an access to Bedrock models
AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<key>
AWS_ASSUME_ROLE_ARN=<role>
AWS_DEFAULT_REGION=us-east-1
AWS_CLAUDE_DEFAULT_CLIENT=legacy

DIAL_URL=<dial core url>

# Misc env vars for the server
LOG_LEVEL=INFO # Default in prod is INFO. Use DEBUG for dev.
WEB_CONCURRENCY=1 # Number of uvicorn workers
COMPATIBILITY_MAPPING={} # Maps unsupported Bedrock deployment names to the compatible and supported by the Adapter deployment names

# AWS STS session tags to pass when assuming a role for the Bedrock client,
# as a JSON object mapping the AWS tag key to the field to take it from:
# `Bedrock.modelId` for the requested model, `UserInfo.<path>` for a DIAL
# /user/info field (which requires DIAL_URL), e.g.
# AWS_SESSION_TAGS={"application":"Bedrock.modelId","project":"UserInfo.project"}
# Leave empty to disable.
AWS_SESSION_TAGS=

PYDANTIC_V2=1
